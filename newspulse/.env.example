# Copy to .env and fill in. Never commit the result.

# --- Required before the dashboard is reachable off the host ----------------
# Without these it refuses to bind anything but loopback: it serves client
# coverage and strategy notes with no other protection.
NEWSPULSE_AUTH_USER=lucas
NEWSPULSE_AUTH_PASSWORD=

# The address links in outgoing mail point at. Unset, the morning digest emails
# a link to the recipient's own machine.
NEWSPULSE_BASE_URL=https://newspulse.example.com

# --- Analysis ----------------------------------------------------------------
# Where the `claude` CLI keeps its login. Mounted from ./claude in compose.
NEWSPULSE_CLAUDE_CONFIG_DIR=/data/claude

# --- Optional ----------------------------------------------------------------
# The zone every displayed time is shown in, and the one that decides where a day
# starts. Defaults to Europe/Berlin; set it only if the reader is elsewhere. Never
# left to the container's clock — that is UTC, and it showed every time two hours
# early.
# NEWSPULSE_TIMEZONE=Europe/Berlin
# NEWSPULSE_ALERT_THRESHOLD=8
# NEWSPULSE_GOOGLE_NEWS=1

# --- Morning digest (leave blank to disable) ---------------------------------
# NEWSPULSE_SMTP_HOST=
# NEWSPULSE_SMTP_PORT=587
# NEWSPULSE_SMTP_USERNAME=
# NEWSPULSE_SMTP_PASSWORD=
# NEWSPULSE_SMTP_SENDER=
# NEWSPULSE_SMTP_RECIPIENT=

# Optional AI fallback. Used only when the Claude subscription reports its usage
# limit is reached; every other failure still fails on the primary. Adds Google
# as a second processor of client coverage — see docs/deployment.md.
# NEWSPULSE_GEMINI_API_KEY=
# NEWSPULSE_GEMINI_MODEL=gemini-2.5-flash

# The second model that cross-checks every personalised message before a human
# sends it. A different provider on purpose: the model that wrote a pitch is the
# worst judge of whether it oversells. Without it the page says a letter went
# unchecked, which is honest — it never pretends silence means approval.
# The bare GEMINI_API_KEY is read too, so an exported shell key already works.
